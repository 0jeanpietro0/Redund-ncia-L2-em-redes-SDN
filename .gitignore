# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Configurações locais e segredos
.env
.env.*
*.pem
*.key

# Logs, capturas e resultados brutos
*.log
*.pcap
*.pcapng
reproducao/resultados/brutos/*
!reproducao/resultados/brutos/.gitkeep

# Máquinas virtuais: publicar somente como ativo de uma GitHub Release
*.ova
*.ovf
*.vdi
*.vmdk
*.vhd
*.vbox
reproducao/maquina_virtual/arquivos/*
!reproducao/maquina_virtual/arquivos/.gitkeep

# Arquivos temporários de ferramentas e editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Saídas temporárias dos testes
*.tmp
*.pid
